# Comma-separated exact hosts, IP addresses, CIDRs, and explicit wildcard domains.
# TCP probing starts automatically only when the submitted target matches this scope.
# Examples:
# NETRECON_ACTIVE_SCAN_ALLOWLIST=yourdomain.example,api.yourdomain.example
# NETRECON_ACTIVE_SCAN_ALLOWLIST=*.yourdomain.example,203.0.113.24
# NETRECON_ACTIVE_SCAN_ALLOWLIST=198.51.100.0/28
NETRECON_ACTIVE_SCAN_ALLOWLIST=

# Optional distributed rate limiting for serverless deployments.
# Create a dedicated Upstash Redis database and keep both values server-side.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
